# Public defaults for LOCAL DEVELOPMENT ONLY. Never use these keys in production.
# Copy this file to .env at the repository root (not backend/.env).
# APP_KEY decodes to exactly 32 bytes, as required by Laravel's AES-256-CBC.
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
REVERB_APP_ID=dinostar
REVERB_APP_KEY=dinostar-local
REVERB_APP_SECRET=dinostar-local-development-only

# Shared by PostgreSQL and Laravel. Public LOCAL DEVELOPMENT default only.
POSTGRES_PASSWORD=dinostar-local-development-only
